# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Email server for sign-up / password-reset codes. Without it, codes go to the container log.
# Hostinger email (e.g. a no-reply@kepexo.com mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@kepexo.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=Kepexo Trader <no-reply@kepexo.com>
# Phone-only sign-up/login check on the server (set to off only for testing)
DEVICE_GATE=on
# Maximum number of accounts
MAX_USERS=50
